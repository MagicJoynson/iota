{"counter":"つ","use":"general things (1-10)","forms":"ひとつ ふたつ みっつ よっつ いつつ むっつ ななつ やっつ ここのつ とお","example":"りんごを三つください。"},
{"counter":"人 (にん)","use":"people","forms":"ひとり ふたり さんにん よにん…","example":"学生が四人います。"},
{"counter":"本 (ほん)","use":"long thin things (bottles, pens, films, trains)","forms":"いっぽん にほん さんぼん…ろっぽん…はっぽん…じゅっぽん","example":"ビールを二本ください。"},
{"counter":"枚 (まい)","use":"flat things (paper, tickets, shirts)","forms":"いちまい にまい さんまい…","example":"きっぷを一枚ください。"},
{"counter":"匹 (ひき)","use":"small animals","forms":"いっぴき にひき さんびき…","example":"ねこが三匹います。"},
{"counter":"台 (だい)","use":"machines & vehicles (karts!)","forms":"いちだい にだい さんだい…","example":"カートが十台あります。"},
{"counter":"回 (かい)","use":"times / occurrences","forms":"いっかい にかい さんかい…","example":"週に三回練習します。"},
{"counter":"歳 (さい)","use":"age","forms":"いっさい にさい…はたち(20)…","example":"二十歳です。"},
{"counter":"分 (ふん/ぷん)","use":"minutes","forms":"いっぷん にふん さんぷん よんぷん ごふん ろっぷん ななふん はっぷん きゅうふん じゅっぷん","example":"十分ぐらいかかります。"},
{"counter":"時 (じ)","use":"o'clock","forms":"いちじ…よじ(4)…しちじ(7)…くじ(9)…","example":"九時に始まります。"},
{"counter":"月 (がつ)","use":"months of the year","forms":"いちがつ…しがつ(April)…しちがつ(July)…くがつ(September)","example":"九月に日本へ行きます。"},
{"counter":"日 (にち/か)","use":"days of month","forms":"ついたち ふつか みっか よっか いつか むいか なのか ようか ここのか とおか…はつか(20th)","example":"十四日に帰ります。"},
{"counter":"階 (かい)","use":"floors of a building","forms":"いっかい にかい…","example":"三階にあります。"},
{"counter":"冊 (さつ)","use":"books/volumes","forms":"いっさつ にさつ…","example":"ノートを二冊買いました。"},
{"counter":"杯 (はい)","use":"cups/glassfuls","forms":"いっぱい にはい さんばい…","example":"コーヒーを一杯どうですか。"}
